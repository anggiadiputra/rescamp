PORT=3000
# REQUIRED. Frontend origin (no trailing slash). Used for CORS + Sumopod return URLs.
CORS_ORIGIN=
# REQUIRED. Same as CORS_ORIGIN. Used by auth service for reset/email links.
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=domain_dashboard

JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRY=24h
DEFAULT_RESELLER_ID=123456

# REQUIRED. AES-256-GCM encryption key for sensitive data at rest (API keys, OTP codes).
# Must be at least 32 characters. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-this-in-production-min-32-chars!!

# Sumopod Payment Gateway — required in production.
# Get the API key from the Sumopod merchant dashboard.
SUMOPOD_API_KEY=
SUMOPOD_PAYMENT_URL=https://api.sumopod.com/v1
SUMOPOD_WEBHOOK_TOKEN=
SUMOPOD_WEBHOOK_SECRET=

# Resellercamp (Domains-as-a-Service) — upstream domain API.
# Override only if pointing at staging or mirror.
LIQUID_BASE_URL=https://api.liqu.id/v1

# Third-party service endpoints. Override only if pointing at staging or mirror.
# These can also be set via the Settings page (DB) for runtime overrides.
KIRISAN_API_URL=https://api.kirisan.com/v1
FONNTE_API_URL=https://api.fonnte.com
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
