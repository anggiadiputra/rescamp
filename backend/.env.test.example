# Test environment — copy to backend/.env.test and fill in real values.
# .env.test is gitignored. Do NOT commit real credentials.

# Resellercamp (Domains-as-a-Service) credentials used by register-flow tests.
# Required by: test/e2e.test.ts, test/auth.integration.test.ts
TEST_RESELLER_ID=
TEST_API_KEY=

# Pre-seeded test account used by login-flow tests.
# Required by: test/auth.integration.test.ts, test/contract.test.ts
# Must already exist in DB; password must match its hash.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
