# Test environment — copy to backend/.env.test and fill in real values.
# .env.test is gitignored. Do NOT commit real credentials.

# Integration/E2E tests are opt-in and require a running backend.
RUN_INTEGRATION_TESTS=false

# Obtain this token through /auth/send-otp -> /auth/verify-otp.
# Never commit a real token.
TEST_AUTH_TOKEN=
